# Copy this file to backend/.env and fill in the real credential locally.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# The first model is used first; exhausted/unavailable models are skipped.
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_MODELS=qwen3.7-flash-2026-07-15,qwen3.5-flash-2026-02-23,qwen3-8b,qwen-plus-0112,qwen3-next-80b-a3b-thinking,qwen3.5-27b,qwen3-14b
QWEN_TIMEOUT_SECONDS=180
QWEN_TEXT_MAX_TOKENS=8192
# Total tries for one logical LLM node after model-pool failover is exhausted.
QWEN_NODE_MAX_ATTEMPTS=2
SCIDATA_LLM_VALIDATE_MAX_RECORDS=12

# VL model pool for figure/chart extraction.
QWEN_VL_MODEL=qwen3-vl-235b-a22b-thinking
QWEN_VL_MODELS=qwen3-vl-235b-a22b-thinking,qwen3-vl-32b-thinking,qwen-vl-plus
QWEN_VL_TIMEOUT_SECONDS=180
QWEN_VL_MAX_TOKENS=8192

# Dynamic Agent runtime safety controls.
SCIDATA_AGENT_MAX_ITERATIONS=24
SCIDATA_AGENT_NO_PROGRESS_LIMIT=4
SCIDATA_AGENT_POLICY_RETRY_LIMIT=2

# Optional Hugging Face mirror and local cache compatibility switches.
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_SYMLINKS=1
# Disabled by default because the optional models are large and must be cached
# explicitly for reliable/offline deployments.
USE_TABLE_TRANSFORMER=false

# Comma-separated browser origins used by the frontend in development.
SCIDATA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload guardrails used by the FastAPI adapter.
SCIDATA_MAX_UPLOAD_FILES=20
SCIDATA_MAX_UPLOAD_BYTES=52428800
SCIDATA_MAX_UPLOAD_TOTAL_BYTES=209715200
# Reject oversized request bodies before multipart parsing/spooling begins.
SCIDATA_MAX_REQUEST_BODY_BYTES=220200960
SCIDATA_MAX_PENDING_TASKS=8
SCIDATA_RATE_LIMIT_PER_MINUTE=60
# Only enable this behind a trusted reverse proxy that overwrites forwarded headers.
SCIDATA_TRUST_PROXY_HEADERS=false
# Optional protection for any non-local deployment. Leave empty for local-only use.
SCIDATA_API_TOKEN=

# Bounded concurrency for independent network and extraction work.
SCIDATA_SEARCH_MAX_WORKERS=4
SCIDATA_PDF_DOWNLOAD_MAX_WORKERS=3
SCIDATA_PDF_PARSE_MAX_WORKERS=2
SCIDATA_CHART_MAX_WORKERS=2
SCIDATA_DYNAMIC_EXTRACTION_MAX_WORKERS=2
SCIDATA_TEXT_EXTRACTION_MAX_WORKERS=2
SCIDATA_TABLE_EXTRACTION_MAX_WORKERS=2

# Backwards-compatible fallbacks used by existing deployments.
SCIDATA_CONNECTOR_WORKERS=4
SCIDATA_LLM_BLOCK_WORKERS=2

# Public-source request resilience. These are operational controls, not
# scientific-data truncation limits. Search results are cached per task when
# the Agent passes its output directory to the connector registry.
SCIDATA_CONNECTOR_MIN_INTERVAL_SECONDS=0.25
SCIDATA_CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=3
SCIDATA_CONNECTOR_CIRCUIT_COOLDOWN_SECONDS=60
SCIDATA_CONNECTOR_JITTER_RATIO=0.25
SCIDATA_SEARCH_RETRY_ROUNDS=1
SCIDATA_SEARCH_CACHE_TTL_SECONDS=86400

# Download and render resource limits.
SCIDATA_ARXIV_MAX_PDF_BYTES=104857600
SCIDATA_PDF_RENDER_TIMEOUT_SECONDS=180
