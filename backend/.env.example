DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-rnoysjhg8497nupd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_WORKSPACE_ID=ws-rnoysjhg8497nupd
QWEN_MODEL=qwen-flash-2025-07-28
QWEN_MODELS=qwen-flash-2025-07-28
QWEN_TIMEOUT_SECONDS=180

# Vision model for figure/chart extraction (Qwen3-VL thinking on Bailian)
QWEN_VL_MODEL=qwen3-vl-235b-a22b-thinking
QWEN_VL_MODELS=qwen3-vl-235b-a22b-thinking,qwen3-vl-32b-thinking,qwen-vl-plus
QWEN_VL_TIMEOUT_SECONDS=180
QWEN_VL_MAX_TOKENS=8192

# Hugging Face mirror + Windows symlink workaround for Table Transformer models
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS=1


# Bounded concurrency for independent network work inside one Agent task.
SCIDATA_SEARCH_MAX_WORKERS=4
SCIDATA_PDF_DOWNLOAD_MAX_WORKERS=3
SCIDATA_PDF_PARSE_MAX_WORKERS=2
SCIDATA_CHART_MAX_WORKERS=2
SCIDATA_DYNAMIC_EXTRACTION_MAX_WORKERS=2
SCIDATA_TEXT_EXTRACTION_MAX_WORKERS=2
SCIDATA_TABLE_EXTRACTION_MAX_WORKERS=2